{
  "name": "profdle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "predev": "npm run years:populate",
    "prebuild": "npm run verify:data && npm run years:populate",
    "build": "vite build",
    "build:pages": "GH_PAGES=1 BASE_PATH=tritondle vite build",
    "lint": "eslint . && npm run verify:data",
    "preview": "vite preview --open",
    "serve": "npm run build && vite preview --open",
    "verify:data": "node scripts/verifyprofessors.mjs",
    "sunset:classes": "node scripts/mergesunsetclasses.mjs",
    "sunset:classes:dry": "node scripts/mergesunsetclasses.mjs --dry-run",
    "research:patch": "node scripts/patchresearchareas.mjs",
    "years:wipe": "node scripts/years.mjs wipe",
    "years:sync": "node scripts/years.mjs sync",
    "years:from-roster": "node scripts/years.mjs populate",
    "years:populate": "node scripts/years.mjs populate",
    "years:draft-site": "node scripts/draft-dsc-start-years-from-site.mjs",
    "years:draft-site:apply": "node scripts/draft-dsc-start-years-from-site.mjs --apply",
    "roster:spreadsheet": "node scripts/export-professors-spreadsheet.mjs"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "pdf-parse": "^2.4.5",
    "vite": "^8.0.10"
  }
}
